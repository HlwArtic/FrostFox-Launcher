diff --git a/app_mojo/src/main/java/git/artdeell/mojo/instances/FrostSetup.java b/app_mojo/src/main/java/git/artdeell/mojo/instances/FrostSetup.java
new file mode 100644
index 0000000000000000000000000000000000000000..e75fff6aa42feea611908c443585226b9b5a0e6e
--- /dev/null
+++ b/app_mojo/src/main/java/git/artdeell/mojo/instances/FrostSetup.java
@@ -0,0 +1,216 @@
+package git.artdeell.mojo.instances;
+
+import android.content.res.AssetManager;
+import android.util.Log;
+
+import com.kdt.mcgui.ProgressLayout;
+
+import git.artdeell.mojo.JVersionList;
+import git.artdeell.mojo.LauncherActivity;
+import git.artdeell.mojo.MojoApplication;
+import git.artdeell.mojo.R;
+import git.artdeell.mojo.Tools;
+import git.artdeell.mojo.frost.ForgeInstallerReader;
+import git.artdeell.mojo.modding.forge.ForgelikeUtils;
+import git.artdeell.mojo.progresskeeper.DownloaderProgressWrapper;
+import git.artdeell.mojo.tasks.mojson.MoJsonDownloader;
+import git.artdeell.mojo.tasks.mojson.MoJsonExtras;
+import git.artdeell.mojo.utils.DownloadUtils;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * FrostFox: first-run setup and fast start.
+ *
+ * Setup ("DOWNLOAD" button): installs Forge without any installer window, then downloads the game
+ * files, and remembers the finished class path. After that, "PLAY" skips all download checks and
+ * starts the game straight away. If anything the launcher relies on goes missing, it falls back to
+ * the normal full check, which repairs it.
+ */
+public final class FrostSetup {
+    private static final String TAG = "FrostSetup";
+    private static final String CACHE_NAME = "frostfox_classpath.txt";
+
+    /** Time of the last tap on Play, passed on to the game process so startup can be timed. */
+    public static volatile long sPlayTime;
+    /** Called whenever the setup state changes (started, finished, failed). May run on any thread. */
+    public static volatile Runnable sListener;
+    private static volatile boolean sRunning;
+
+    private FrostSetup() {
+    }
+
+    public static boolean isRunning() {
+        return sRunning;
+    }
+
+    private static void notifyListener() {
+        Runnable listener = sListener;
+        if (listener != null) listener.run();
+    }
+
+    // ---------------------------------------------------------------- saved class path
+
+    private static File cacheFile(String versionId) {
+        return new File(MoJsonDownloader.createGameJsonPath(versionId).getParentFile(), CACHE_NAME);
+    }
+
+    /** The class path of a fully downloaded version, or null if anything it needs is missing. */
+    public static File[] cachedClasspath(String versionId) {
+        if (versionId == null) return null;
+        File cache = cacheFile(versionId);
+        if (!cache.isFile()) return null;
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(new FileInputStream(cache), "UTF-8"))) {
+            boolean needsNatives = "natives=1".equals(reader.readLine());
+            List<File> files = new ArrayList<>();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (line.isEmpty()) continue;
+                File file = new File(line);
+                if (!file.isFile()) return null;
+                files.add(file);
+            }
+            if (files.isEmpty()) return null;
+            if (needsNatives) {
+                String[] natives = new File(Tools.DIR_CACHE, "natives/" + versionId).list();
+                if (natives == null || natives.length == 0) return null;
+            }
+            return files.toArray(new File[0]);
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    private static void saveClasspath(String versionId, File[] classpath) throws IOException {
+        String[] natives = new File(Tools.DIR_CACHE, "natives/" + versionId).list();
+        File cache = cacheFile(versionId);
+        File partial = new File(cache.getPath() + ".part");
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(partial), "UTF-8"))) {
+            writer.write(natives != null && natives.length > 0 ? "natives=1" : "natives=0");
+            writer.write('\n');
+            for (File file : classpath) {
+                writer.write(file.getAbsolutePath());
+                writer.write('\n');
+            }
+        }
+        if (cache.exists() && !cache.delete()) throw new IOException("Could not replace " + cache);
+        if (!partial.renameTo(cache)) throw new IOException("Could not save " + cache);
+    }
+
+    // ---------------------------------------------------------------- state
+
+    /** True if this instance still has to be downloaded (the button then says DOWNLOAD). */
+    public static boolean needsSetup(Instance instance) {
+        if (instance == null || !instance.autoForge) return false;
+        String id = instance.versionId;
+        if (id == null || !id.toLowerCase(Locale.ROOT).contains("forge")) return true;
+        return cachedClasspath(MoJsonExtras.normalizeVersionId(id)) == null;
+    }
+
+    // ---------------------------------------------------------------- setup
+
+    public static void start(LauncherActivity activity, Instance instance) {
+        if (sRunning) return;
+        sRunning = true;
+        notifyListener();
+        final AssetManager assets = activity.getAssets();
+        ProgressLayout.setProgress(ProgressLayout.INSTANCE_INSTALL, 0);
+        MojoApplication.sExecutorService.execute(() -> {
+            try {
+                String versionId = ensureForge(instance);
+                ProgressLayout.clearProgress(ProgressLayout.INSTANCE_INSTALL);
+                final String normalized = MoJsonExtras.normalizeVersionId(versionId);
+                JVersionList.Version listed = MoJsonExtras.getListedVersion(normalized);
+                new MoJsonDownloader().start(assets, listed, normalized, new MoJsonExtras.DoneListener() {
+                    @Override
+                    public void onDownloadDone(File[] classpath) {
+                        try {
+                            saveClasspath(normalized, classpath);
+                        } catch (IOException e) {
+                            Log.w(TAG, "Could not save the class path", e);
+                        }
+                        finish(null);
+                    }
+
+                    @Override
+                    public void onDownloadFailed(Throwable throwable) {
+                        finish(throwable);
+                    }
+                });
+            } catch (ForgeInstallerReader.Unsupported e) {
+                ProgressLayout.clearProgress(ProgressLayout.INSTANCE_INSTALL);
+                Log.w(TAG, "Falling back to the Forge installer window: " + e.getMessage());
+                fallBackToInstaller(instance);
+            } catch (Exception e) {
+                ProgressLayout.clearProgress(ProgressLayout.INSTANCE_INSTALL);
+                finish(e);
+            }
+        });
+    }
+
+    private static void finish(Throwable error) {
+        sRunning = false;
+        if (error != null) Tools.showErrorRemote("The download failed", error);
+        notifyListener();
+    }
+
+    /** Installs Forge quietly. Returns the Forge version id the instance now uses. */
+    private static String ensureForge(Instance instance) throws IOException {
+        String current = instance.versionId;
+        if (current != null && current.toLowerCase(Locale.ROOT).contains("forge")
+                && MoJsonDownloader.createGameJsonPath(current).isFile()) {
+            return current; // Forge is already installed
+        }
+
+        final InstanceInstaller info = ForgelikeUtils.FORGE_UTILS.createInstaller(ForgeAutoInstall.FORGE_VERSION);
+        final File jar = new File(info.installerJar);
+        final byte[] buffer = new byte[8192];
+        final DownloaderProgressWrapper wrapper = new DownloaderProgressWrapper(
+                R.string.mcl_launch_downloading_progress, ProgressLayout.INSTANCE_INSTALL);
+        wrapper.extraString = "Forge";
+        DownloadUtils.ensureSha1(jar, info.installerSha1, () ->
+                DownloadUtils.downloadFileMonitored(info.installerDownloadUrl, jar, buffer, wrapper));
+
+        try {
+            ForgeInstallerReader.Result result = ForgeInstallerReader.read(jar, new File(Tools.DIR_HOME_LIBRARY));
+            File jsonFile = MoJsonDownloader.createGameJsonPath(result.versionId);
+            File parent = jsonFile.getParentFile();
+            if (parent != null && !parent.isDirectory() && !parent.mkdirs()) {
+                throw new IOException("Could not create " + parent);
+            }
+            try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(jsonFile), "UTF-8"))) {
+                writer.write(result.versionJson);
+            }
+            instance.versionId = result.versionId;
+            instance.installer = null;
+            instance.write();
+            return result.versionId;
+        } finally {
+            //noinspection ResultOfMethodCallIgnored
+            jar.delete();
+        }
+    }
+
+    /** Last resort: the old installer window, if the installer is not shaped as expected. */
+    private static void fallBackToInstaller(Instance instance) {
+        try {
+            InstanceInstaller installer = ForgelikeUtils.FORGE_UTILS.createInstaller(ForgeAutoInstall.FORGE_VERSION);
+            instance.installer = installer;
+            instance.write();
+            installer.start();
+            finish(null);
+        } catch (Exception e) {
+            finish(e);
+        }
+    }
+}
