diff --git a/app_mojo/src/main/java/git/artdeell/mojo/frost/ForgeInstallerReader.java b/app_mojo/src/main/java/git/artdeell/mojo/frost/ForgeInstallerReader.java
new file mode 100644
index 0000000000000000000000000000000000000000..bb12c5209d639eb7871b58c5f603957493fc1f2d
--- /dev/null
+++ b/app_mojo/src/main/java/git/artdeell/mojo/frost/ForgeInstallerReader.java
@@ -0,0 +1,111 @@
+package git.artdeell.mojo.frost;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/**
+ * FrostFox: reads a Forge 1.8.x installer jar without running its window.
+ * It takes the version description out of install_profile.json and copies the Forge
+ * universal jar to the place where the launcher expects its library. No Android classes are used.
+ */
+public final class ForgeInstallerReader {
+    /** The installer does not look the way this reader expects. The caller can fall back to the real installer. */
+    public static final class Unsupported extends IOException {
+        public Unsupported(String message) {
+            super(message);
+        }
+    }
+
+    public static final class Result {
+        public String versionId;
+        /** The complete version description to save as versions/&lt;id&gt;/&lt;id&gt;.json */
+        public String versionJson;
+        /** Where the universal jar was copied to, below the libraries folder. */
+        public File libraryFile;
+    }
+
+    private ForgeInstallerReader() {
+    }
+
+    public static Result read(File installerJar, File librariesRoot) throws IOException {
+        try (ZipFile zip = new ZipFile(installerJar)) {
+            ZipEntry profileEntry = zip.getEntry("install_profile.json");
+            if (profileEntry == null) throw new Unsupported("The installer has no install_profile.json");
+            JsonObject profile;
+            try (InputStream in = zip.getInputStream(profileEntry);
+                 InputStreamReader reader = new InputStreamReader(in, "UTF-8")) {
+                JsonElement element = new JsonParser().parse(reader);
+                if (!element.isJsonObject()) throw new Unsupported("install_profile.json is not an object");
+                profile = element.getAsJsonObject();
+            } catch (RuntimeException e) {
+                throw new Unsupported("install_profile.json is damaged: " + e.getMessage());
+            }
+            JsonObject install = object(profile, "install");
+            JsonObject versionInfo = object(profile, "versionInfo");
+            if (install == null || versionInfo == null) throw new Unsupported("The installer uses a newer layout");
+
+            String versionId = text(versionInfo, "id");
+            if (versionId == null) versionId = text(install, "target");
+            String coordinate = text(install, "path");
+            String filePath = text(install, "filePath");
+            if (versionId == null || coordinate == null || filePath == null) {
+                throw new Unsupported("The installer is missing version information");
+            }
+            if (!versionId.matches("[A-Za-z0-9._+-]+")) throw new Unsupported("Unexpected version id");
+
+            ZipEntry universal = zip.getEntry(filePath);
+            if (universal == null) throw new Unsupported("The installer does not contain " + filePath);
+            File target = new File(librariesRoot, relativeLibraryPath(coordinate));
+            File parent = target.getParentFile();
+            if (parent != null && !parent.isDirectory() && !parent.mkdirs()) {
+                throw new IOException("Could not create " + parent);
+            }
+            File partial = new File(target.getPath() + ".part");
+            try (InputStream in = zip.getInputStream(universal); OutputStream out = new FileOutputStream(partial)) {
+                byte[] buffer = new byte[16384];
+                int read;
+                while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            }
+            if (target.exists() && !target.delete()) throw new IOException("Could not replace " + target);
+            if (!partial.renameTo(target)) throw new IOException("Could not move " + partial + " into place");
+
+            Result result = new Result();
+            result.versionId = versionId;
+            result.versionJson = versionInfo.toString();
+            result.libraryFile = target;
+            return result;
+        }
+    }
+
+    /** "group:artifact:version[:classifier]" becomes "group/path/artifact/version/artifact-version[-classifier].jar" */
+    static String relativeLibraryPath(String coordinate) throws Unsupported {
+        String[] parts = coordinate.split(":");
+        if (parts.length < 3 || parts.length > 4) throw new Unsupported("Unexpected library name " + coordinate);
+        for (String part : parts) {
+            if (!part.matches("[A-Za-z0-9._+-]+")) throw new Unsupported("Unexpected library name " + coordinate);
+        }
+        String group = parts[0].replace('.', '/');
+        String file = parts[1] + "-" + parts[2] + (parts.length == 4 ? "-" + parts[3] : "") + ".jar";
+        return group + "/" + parts[1] + "/" + parts[2] + "/" + file;
+    }
+
+    private static JsonObject object(JsonObject parent, String key) {
+        JsonElement element = parent.get(key);
+        return element != null && element.isJsonObject() ? element.getAsJsonObject() : null;
+    }
+
+    private static String text(JsonObject parent, String key) {
+        JsonElement element = parent.get(key);
+        return element != null && element.isJsonPrimitive() ? element.getAsString() : null;
+    }
+}
