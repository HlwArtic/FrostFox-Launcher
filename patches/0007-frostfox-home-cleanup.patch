@@ -0,0 +1,56 @@
+package git.artdeell.mojo.frost;
+
+import android.graphics.Bitmap;
+import android.graphics.Color;
+
+import java.util.Locale;
+
+/**
+ * FrostFox: a small pixel "player head" for accounts that have no skin (offline accounts).
+ * The colours come from the player name, so the same name always gets the same head.
+ * Original artwork: a plain 8x8 face, not taken from Minecraft.
+ */
+public final class FrostHead {
+    private static final int[] SKIN = {0xFFF5D0B5, 0xFFE0AC8A, 0xFFC68B63, 0xFF9C6644, 0xFF6F4A33};
+    private static final int[] HAIR = {0xFF3B2A1F, 0xFF1C1C24, 0xFFB5651D, 0xFFE8C766,
+            0xFF8E3B2F, 0xFF5A6B7D, 0xFFEDEDED};
+    private static final int EYE = 0xFF16213A;
+    private static final String[] GRID = {
+            "HHHHHHHH",
+            "HHHHHHHH",
+            "HSSSSSSH",
+            "HSESSESH",
+            "SSSSSSSS",
+            "SSSSSSSS",
+            "SSMMMMSS",
+            "SSSSSSSS",
+    };
+
+    private FrostHead() {
+    }
+
+    public static Bitmap create(String name) {
+        int hash = name == null ? 0 : name.toLowerCase(Locale.ROOT).hashCode();
+        int skin = SKIN[(hash & 0x7fffffff) % SKIN.length];
+        int hair = HAIR[((hash >>> 8) & 0x7fffffff) % HAIR.length];
+        int mouth = Color.rgb((int) (Color.red(skin) * 0.7f), (int) (Color.green(skin) * 0.7f),
+                (int) (Color.blue(skin) * 0.7f));
+
+        Bitmap small = Bitmap.createBitmap(8, 8, Bitmap.Config.ARGB_8888);
+        for (int y = 0; y < 8; y++) {
+            for (int x = 0; x < 8; x++) {
+                int color;
+                switch (GRID[y].charAt(x)) {
+                    case 'H': color = hair; break;
+                    case 'E': color = EYE; break;
+                    case 'M': color = mouth; break;
+                    default: color = skin; break;
+                }
+                small.setPixel(x, y, color);
+            }
+        }
+        Bitmap big = Bitmap.createScaledBitmap(small, 96, 96, false);
+        small.recycle();
+        return big;
+    }
+}
