+    // FrostFox: settings export and import
+    private final ActivityResultLauncher<String> mExportLauncher = registerForActivityResult(
+            new git.artdeell.mojo.contracts.CreateZipDocument(), uri -> {
+                if(uri != null) runExport(uri);
+            });
+    private final ActivityResultLauncher<Object> mImportLauncher = registerForActivityResult(
+            new git.artdeell.mojo.contracts.OpenDocumentWithExtension("zip"), uri -> {
+                if(uri != null) confirmImport(uri);
+            });
+
+    private void runExport(Uri uri) {
+        final android.content.Context context = getLauncherActivity().getApplicationContext();
+        MojoApplication.sExecutorService.execute(() -> {
+            String message;
+            try (java.io.OutputStream out = context.getContentResolver().openOutputStream(uri)) {
+                if(out == null) throw new IOException("Could not open the file");
+                git.artdeell.mojo.frost.SettingsBackup.export(out);
+                message = "Settings exported";
+            } catch (IOException e) {
+                message = "Export failed: " + e.getMessage();
+            }
+            final String toast = message;
+            Tools.runOnUiThread(() -> Toast.makeText(context, toast, Toast.LENGTH_LONG).show());
+        });
+    }
+
+    private void confirmImport(Uri uri) {
+        new AlertDialog.Builder(getLauncherActivity())
+                .setTitle("Import settings")
+                .setMessage("This replaces your current launcher settings and control layouts with the ones in the file. "
+                        + "Instances with the same folder name get their settings replaced; mods and worlds are not touched. "
+                        + "Accounts are never changed.")
+                .setPositiveButton(android.R.string.ok, (d, w) -> runImport(uri))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void runImport(Uri uri) {
+        final LauncherActivity activity = getLauncherActivity();
+        MojoApplication.sExecutorService.execute(() -> {
+            String message;
+            try (java.io.InputStream in = activity.getContentResolver().openInputStream(uri)) {
+                if(in == null) throw new IOException("Could not open the file");
+                message = git.artdeell.mojo.frost.SettingsBackup.importFrom(activity, in)
+                        + "\n\nClose and reopen the launcher to apply everything.";
+            } catch (IOException e) {
+                message = "Import failed: " + e.getMessage();
+            }
+            final String text = message;
+            Tools.runOnUiThread(() -> new AlertDialog.Builder(activity)
+                    .setTitle("Import settings")
+                    .setMessage(text)
+                    .setPositiveButton(android.R.string.ok, null)
+                    .show());
+        });
+    }
+
