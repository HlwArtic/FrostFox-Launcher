diff --git a/app_mojo/src/main/java/git/artdeell/mojo/instances/ForgeAutoInstall.java b/app_mojo/src/main/java/git/artdeell/mojo/instances/ForgeAutoInstall.java
new file mode 100644
index 0000000..4d5c64c
--- /dev/null
+++ b/app_mojo/src/main/java/git/artdeell/mojo/instances/ForgeAutoInstall.java
@@ -0,0 +1,44 @@
+package git.artdeell.mojo.instances;
+
+import com.kdt.mcgui.ProgressLayout;
+
+import git.artdeell.mojo.MojoApplication;
+import git.artdeell.mojo.Tools;
+import git.artdeell.mojo.modding.forge.ForgelikeUtils;
+
+import java.util.Locale;
+
+/**
+ * FrostFox: installs Forge 1.8.9 automatically the first time an instance is played.
+ * Reuses the existing installer pipeline (download, SHA-1 check, auto-clicked installer),
+ * so the user does not have to open any Forge menu.
+ */
+public final class ForgeAutoInstall {
+    public static final String FORGE_VERSION = "1.8.9-11.15.1.2318-1.8.9";
+
+    private ForgeAutoInstall() {
+    }
+
+    /** True if this instance wants Forge but its version is not a Forge version yet. */
+    public static boolean needed(Instance instance) {
+        if(!instance.autoForge) return false;
+        String id = instance.versionId;
+        return id == null || !id.toLowerCase(Locale.ROOT).contains("forge");
+    }
+
+    /** Starts the Forge install in the background. The installer fills in versionId when done. */
+    public static void install(Instance instance) {
+        ProgressLayout.setProgress(ProgressLayout.INSTANCE_INSTALL, 0);
+        MojoApplication.sExecutorService.execute(() -> {
+            try {
+                InstanceInstaller installer = ForgelikeUtils.FORGE_UTILS.createInstaller(FORGE_VERSION);
+                instance.installer = installer;
+                instance.write();
+                installer.start();
+            } catch (Exception e) {
+                ProgressLayout.clearProgress(ProgressLayout.INSTANCE_INSTALL);
+                Tools.showErrorRemote(e);
+            }
+        });
+    }
+}
