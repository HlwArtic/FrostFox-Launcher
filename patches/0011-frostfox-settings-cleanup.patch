+    private void requestLocalSkinFace(File target) {
+        String template = AuthType.MICROSOFT.skinUrl;
+        if(mLocalSkinRequested || template == null) return;
+        // At most once per app start, and only when there is no head yet or it is a week old
+        if(target.exists() && System.currentTimeMillis() - target.lastModified() < 7L * 24 * 60 * 60 * 1000) return;
+        mLocalSkinRequested = true;
+        final String name = username;
+        git.artdeell.mojo.MojoApplication.sExecutorService.execute(() -> {
+            try {
