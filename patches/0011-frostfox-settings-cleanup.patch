+                Bitmap face = new SkinHeadRenderer().render(100, skinBitmap);
+                skinBitmap.recycle();
+                if(face == null) return;
+                FileUtils.ensureParentDirectory(target);
+                try(FileOutputStream out = new FileOutputStream(target)) {
+                    face.compress(Bitmap.CompressFormat.WEBP, 90, out);
+                }
+                mFaceCache = null;
+                Runnable listener = sSkinFaceListener;
+                if(listener != null) listener.run();
+            } catch (IOException e) {
+                Log.w("SkinLoader", "Could not download the skin head for " + name, e);
+            }
+        });
+    }
