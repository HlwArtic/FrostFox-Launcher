+package git.artdeell.mojo.frost;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.zip.ZipFile;
+
+/**
+ * FrostFox: reads a Forge 1.8.9 crash report and works out which mod most likely caused it.
+ * Two clues are used: mods that Forge itself marks as errored in the mod list, and which mod
+ * jar contains the classes named in the error's stack trace. No Android classes are used here.
+ */
+public final class CrashAnalyzer {
+    public static final class Result {
+        public String description;
+        public String errorLine;
+        /** Display name of the suspected mod, or null if none could be named. */
+        public String suspectedName;
+        /** The suspected mod's jar in the mods folder, or null if it could not be matched. */
+        public File suspectedFile;
+        /** Short explanation of why this mod was picked. */
+        public String reason;
+    }
+
+    private static final int MAX_REPORT_CHARS = 600_000;
+    private static final Pattern FRAME = Pattern.compile("^\\s+at ([\\w.$]+)\\.[\\w$<>]+\\(");
+    private static final Pattern ERROR_LINE = Pattern.compile("^[A-Za-z_$][\\w.$]*(Exception|Error|Throwable)(:.*)?$");
+    private static final Pattern MOD_ROW = Pattern.compile("^\\s*([ULCHIJADE]{3,})\\s+(.+?)\\{(.*?)\\}\\s+\\[(.*?)\\]\\s+\\((.*?)\\)");
+    private static final String[] IGNORED_PREFIXES = {
+            "java.", "javax.", "sun.", "jdk.", "com.sun.", "net.minecraft.", "net.minecraftforge.", "cpw.mods.",
+            "org.lwjgl.", "com.google.", "org.apache.", "io.netty.", "org.objectweb.", "com.mojang.",
+            "paulscode.", "org.spongepowered.", "net.minecraft", "git.artdeell.", "android.", "dalvik."
+    };
+
+    private CrashAnalyzer() {
+    }
+
+    public static Result analyze(File report, List<File> modFolders) throws IOException {
+        List<String> lines = readLines(report);
+        Result result = new Result();
+
+        boolean afterDescription = false;
+        List<String> frames = new ArrayList<>();
+        boolean inFirstTrace = true;
+        List<ModRow> erroredRows = new ArrayList<>();
+        boolean inModList = false;
+
+        for (String line : lines) {
+            if (line.startsWith("Description:")) {
+                result.description = line.substring("Description:".length()).trim();
+                afterDescription = true;
+                continue;
+            }
+            if (afterDescription && result.errorLine == null && ERROR_LINE.matcher(line.trim()).matches()) {
+                result.errorLine = line.trim();
+            }
+            if (line.startsWith("A detailed walkthrough")) inFirstTrace = false;
+            if (inFirstTrace) {
+                Matcher frame = FRAME.matcher(line);
+                if (frame.find()) frames.add(frame.group(1));
+            }
+            if (line.trim().startsWith("States:")) {
+                inModList = true;
+                continue;
+            }
+            if (inModList) {
+                Matcher row = MOD_ROW.matcher(line);
+                if (row.find()) {
+                    if (row.group(1).indexOf('E') >= 0) {
+                        String display = row.group(4).trim();
+                        erroredRows.add(new ModRow(display.isEmpty() ? row.group(2).trim() : display, row.group(5).trim()));
+                    }
+                } else if (!line.trim().isEmpty() && !line.startsWith("\t") && !line.startsWith(" ")) {
+                    inModList = false;
+                }
+            }
+        }
+
+        List<File> mods = collectMods(modFolders);
+
+        // Clue 1: Forge marked a mod as errored
+        for (ModRow row : erroredRows) {
+            if (isBuiltIn(row.name)) continue;
+            File jar = findByName(mods, row.file);
+            result.suspectedName = row.name;
+            result.suspectedFile = jar;
+            result.reason = "Forge marked this mod as errored.";
+            return result;
+        }
+
+        // Clue 2: whose classes appear in the stack trace
+        Set<String> classes = new LinkedHashSet<>();
+        for (String className : frames) {
+            if (!isIgnored(className)) classes.add(className);
+        }
+        Map<File, Integer> score = new LinkedHashMap<>();
+        for (File jar : mods) {
+            try (ZipFile zip = new ZipFile(jar)) {
+                int hits = 0;
+                for (String className : classes) {
+                    if (zip.getEntry(className.replace('.', '/') + ".class") != null) hits++;
+                }
+                if (hits > 0) score.put(jar, hits);
+            } catch (IOException ignored) {
+                // Unreadable jar: skip it
+            }
+        }
+        File best = null;
+        int bestScore = 0;
+        for (Map.Entry<File, Integer> entry : score.entrySet()) {
+            if (entry.getValue() > bestScore) {
+                bestScore = entry.getValue();
+                best = entry.getKey();
+            }
+        }
+        if (best != null) {
+            result.suspectedFile = best;
+            result.suspectedName = displayName(best);
+            result.reason = "Its code appears " + bestScore + (bestScore == 1 ? " time" : " times")
+                    + " in the error's stack trace.";
+        }
+        return result;
+    }
+
+    private static final class ModRow {
+        final String name;
+        final String file;
+
+        ModRow(String name, String file) {
+            this.name = name;
+            this.file = file;
+        }
+    }
+
+    private static boolean isBuiltIn(String name) {
+        String lower = name.toLowerCase(Locale.ROOT);
+        return lower.startsWith("mcp") || lower.startsWith("fml") || lower.startsWith("forge")
+                || lower.contains("minecraft coder pack") || lower.contains("forge mod loader")
+                || lower.contains("minecraft forge");
+    }
+
+    private static boolean isIgnored(String className) {
+        for (String prefix : IGNORED_PREFIXES) {
+            if (className.startsWith(prefix)) return true;
+        }
+        return false;
+    }
+
+    private static List<File> collectMods(List<File> folders) {
+        List<File> out = new ArrayList<>();
+        for (File folder : folders) {
+            File[] files = folder.listFiles();
+            if (files == null) continue;
+            for (File file : files) {
+                if (!file.isFile()) continue;
+                String lower = file.getName().toLowerCase(Locale.ROOT);
+                if (lower.endsWith(".jar") || lower.endsWith(".zip")) out.add(file);
+            }
+        }
+        return out;
+    }
+
+    private static File findByName(List<File> mods, String fileName) {
+        for (File file : mods) {
+            if (file.getName().equalsIgnoreCase(fileName)) return file;
+        }
+        return null;
+    }
+
+    private static String displayName(File jar) {
+        String name = jar.getName();
+        int dot = name.lastIndexOf('.');
+        return dot > 0 ? name.substring(0, dot) : name;
+    }
+
+    private static List<String> readLines(File file) throws IOException {
+        List<String> lines = new ArrayList<>();
+        int total = 0;
+        try (BufferedReader reader = new BufferedReader(
+                new InputStreamReader(new FileInputStream(file), "UTF-8"))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                lines.add(line);
+                total += line.length();
+                if (total > MAX_REPORT_CHARS) break;
+            }
+        }
+        return lines;
+    }
+}
