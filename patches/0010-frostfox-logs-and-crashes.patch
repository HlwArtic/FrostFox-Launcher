+package git.artdeell.mojo.fragments;
+
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.graphics.Typeface;
+import android.os.Bundle;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog;
+import androidx.appcompat.widget.SwitchCompat;
+import androidx.fragment.app.Fragment;
+
+import git.artdeell.mojo.MojoApplication;
+import git.artdeell.mojo.Tools;
+import git.artdeell.mojo.frost.CrashAnalyzer;
+import git.artdeell.mojo.instances.Instance;
+import git.artdeell.mojo.instances.Instances;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * FrostFox: log viewer and crash reports in one screen. Shows the end of the game log (with an
+ * "errors only" filter), and lists the instance's crash reports. For a Forge crash report it names
+ * the mod most likely responsible and can switch that mod off with one tap.
+ */
+public class LogsFragment extends Fragment {
+    public static final String TAG = "LogsFragment";
+    private static final int MAX_TAIL_BYTES = 200 * 1024;
+    private static final int MAX_LINES = 800;
+
+    private TextView mLogText;
+    private ScrollView mScroll;
+    private SwitchCompat mErrorsOnly;
+    private String mVisibleLog = "";
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container,
+                             @Nullable Bundle savedInstanceState) {
+        int pad = (int) Tools.dpToPx(16);
+        int gap = (int) Tools.dpToPx(8);
+
+        LinearLayout root = new LinearLayout(requireContext());
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(pad, pad, pad, pad);
+
+        TextView title = new TextView(requireContext());
+        title.setText("Logs");
+        title.setTextSize(22);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        root.addView(title);
+
+        mErrorsOnly = new SwitchCompat(requireContext());
+        mErrorsOnly.setText("Show only warnings and errors");
+        mErrorsOnly.setPadding(0, gap, 0, gap);
+        mErrorsOnly.setOnCheckedChangeListener((button, checked) -> loadLog());
+        root.addView(mErrorsOnly);
+
+        LinearLayout row1 = new LinearLayout(requireContext());
+        row1.addView(makeButton("Refresh", v -> loadLog()));
+        row1.addView(makeButton("Crash reports", v -> showCrashList()));
+        root.addView(row1);
+
+        LinearLayout row2 = new LinearLayout(requireContext());
+        row2.addView(makeButton("Copy", v -> copyLog()));
+        row2.addView(makeButton("Share", v -> Tools.shareLog(requireContext())));
+        root.addView(row2);
+
+        mScroll = new ScrollView(requireContext());
+        mLogText = new TextView(requireContext());
+        mLogText.setTypeface(Typeface.MONOSPACE);
+        mLogText.setTextSize(11);
+        mLogText.setTextIsSelectable(true);
+        mLogText.setPadding(0, gap, 0, 0);
+        mScroll.addView(mLogText);
+        root.addView(mScroll, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+        return root;
+    }
+
+    private Button makeButton(String text, View.OnClickListener listener) {
+        Button button = new Button(requireContext());
+        button.setText(text);
+        button.setAllCaps(false);
+        button.setOnClickListener(listener);
+        button.setLayoutParams(new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        return button;
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        loadLog();
+    }
+
+    // ---------- game log ----------
+
+    private void loadLog() {
+        final boolean errorsOnly = mErrorsOnly.isChecked();
+        MojoApplication.sExecutorService.execute(() -> {
+            String text;
+            try {
+                text = readLogTail(new File(Tools.DIR_GAME_HOME, "latestlog.txt"), errorsOnly);
+            } catch (IOException e) {
+                text = "Could not read the log: " + e.getMessage();
+            }
+            final String shown = text;
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                mVisibleLog = shown;
+                mLogText.setText(shown);
+                mScroll.post(() -> mScroll.fullScroll(View.FOCUS_DOWN));
+            });
+        });
+    }
+
+    private static String readLogTail(File file, boolean errorsOnly) throws IOException {
+        if (!file.exists()) return "No log yet. Start the game once and come back.";
+        byte[] data;
+        boolean cut = false;
+        try (RandomAccessFile raf = new RandomAccessFile(file, "r")) {
+            long length = raf.length();
+            long start = Math.max(0, length - MAX_TAIL_BYTES);
+            cut = start > 0;
+            data = new byte[(int) (length - start)];
+            raf.seek(start);
+            raf.readFully(data);
+        }
+        String text = new String(data, "UTF-8");
+        if (cut) {
+            int newline = text.indexOf('\n');
+            if (newline >= 0) text = text.substring(newline + 1);
+        }
+        List<String> kept = new ArrayList<>();
+        boolean afterError = false;
+        for (String line : text.split("\n")) {
+            if (!errorsOnly) {
+                kept.add(line);
+                continue;
+            }
+            boolean important = line.contains("/ERROR]") || line.contains("/WARN]") || line.contains("/FATAL]")
+                    || line.contains("Exception") || line.contains("Caused by") || line.contains("Error:");
+            boolean frame = line.startsWith("\tat ") || line.startsWith("    at ");
+            if (important || (frame && afterError)) {
+                kept.add(line);
+                afterError = true;
+            } else {
+                afterError = false;
+            }
+        }
+        if (kept.size() > MAX_LINES) kept = kept.subList(kept.size() - MAX_LINES, kept.size());
+        if (kept.isEmpty()) return errorsOnly ? "No warnings or errors in the log." : "The log is empty.";
+        StringBuilder out = new StringBuilder();
+        for (String line : kept) out.append(line).append('\n');
+        return out.toString();
+    }
+
+    private void copyLog() {
+        ClipboardManager clipboard = (ClipboardManager) requireContext().getSystemService(Context.CLIPBOARD_SERVICE);
+        if (clipboard == null) return;
+        clipboard.setPrimaryClip(ClipData.newPlainText("FrostFox log", mVisibleLog));
+        Toast.makeText(requireContext(), "Log copied", Toast.LENGTH_SHORT).show();
+    }
+
+    // ---------- crash reports ----------
+
+    private List<File> modFolders(Instance instance) {
+        File mods = new File(instance.getGameDirectory(), "mods");
+        return Arrays.asList(mods, new File(mods, "1.8.9"));
+    }
+
+    private void showCrashList() {
+        Instance instance = Instances.loadSelectedInstance();
+        if (instance == null) {
+            Toast.makeText(requireContext(), "No instance selected", Toast.LENGTH_LONG).show();
+            return;
+        }
+        File gameDir = instance.getGameDirectory();
+        final List<File> reports = new ArrayList<>();
+        File[] crashFiles = new File(gameDir, "crash-reports").listFiles();
+        if (crashFiles != null) {
+            for (File file : crashFiles) if (file.isFile() && file.getName().endsWith(".txt")) reports.add(file);
+        }
+        File[] javaCrashes = gameDir.listFiles();
+        if (javaCrashes != null) {
+            for (File file : javaCrashes) {
+                if (file.isFile() && file.getName().startsWith("hs_err_pid")) reports.add(file);
+            }
+        }
+        if (reports.isEmpty()) {
+            Toast.makeText(requireContext(), "No crash reports. That's good news.", Toast.LENGTH_LONG).show();
+            return;
+        }
+        Collections.sort(reports, (a, b) -> Long.compare(b.lastModified(), a.lastModified()));
+        final List<File> shown = reports.size() > 20 ? reports.subList(0, 20) : reports;
+        SimpleDateFormat format = new SimpleDateFormat("MMM d, HH:mm", Locale.getDefault());
+        String[] labels = new String[shown.size()];
+        for (int i = 0; i < labels.length; i++) {
+            File file = shown.get(i);
+            String kind = file.getName().startsWith("hs_err_pid") ? "Java crash" : "Game crash";
+            labels[i] = format.format(new Date(file.lastModified())) + "  -  " + kind;
+        }
+        new AlertDialog.Builder(requireContext())
+                .setTitle("Crash reports")
+                .setItems(labels, (dialog, which) -> showCrash(instance, shown.get(which)))
+                .setNegativeButton("Close", null)
+                .show();
+    }
+
+    private void showCrash(Instance instance, File report) {
+        if (report.getName().startsWith("hs_err_pid")) {
+            new AlertDialog.Builder(requireContext())
+                    .setTitle("Java crash")
+                    .setMessage("Java itself stopped, which is usually not caused by a mod. "
+                            + "The most common reasons are too little free memory or a graphics driver problem. "
+                            + "Try the Battery saver settings and close other apps. "
+                            + "You can share this report if you want help.")
+                    .setNeutralButton("Share report", (d, w) -> Tools.openPath(requireContext(), report, true))
+                    .setNegativeButton("Close", null)
+                    .show();
+            return;
+        }
+        final List<File> folders = modFolders(instance);
+        MojoApplication.sExecutorService.execute(() -> {
+            CrashAnalyzer.Result result = null;
+            String failure = null;
+            try {
+                result = CrashAnalyzer.analyze(report, folders);
+            } catch (IOException e) {
+                failure = e.getMessage();
+            }
+            final CrashAnalyzer.Result finalResult = result;
+            final String finalFailure = failure;
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                showCrashDialog(report, finalResult, finalFailure);
+            });
+        });
+    }
+
+    private void showCrashDialog(File report, CrashAnalyzer.Result result, String failure) {
+        StringBuilder message = new StringBuilder();
+        if (result == null) {
+            message.append("Could not read this report: ").append(failure);
+        } else {
+            if (result.description != null) message.append("What happened: ").append(result.description).append("\n\n");
+            if (result.errorLine != null) message.append("Error: ").append(result.errorLine).append("\n\n");
+            if (result.suspectedName != null) {
+                message.append("Most likely mod: ").append(result.suspectedName);
+                if (result.reason != null) message.append("\n").append(result.reason);
+                if (result.suspectedFile == null) message.append("\n(Its file was not found in the mods folder.)");
+            } else {
+                message.append("No mod could be blamed. If you just added or changed mods, "
+                        + "try switching off the newest one.");
+            }
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(requireContext())
+                .setTitle("Crash report")
+                .setMessage(message.toString())
+                .setNeutralButton("Share report", (d, w) -> Tools.openPath(requireContext(), report, true))
+                .setNegativeButton("Close", null);
+        if (result != null && result.suspectedFile != null
+                && !result.suspectedFile.getName().toLowerCase(Locale.ROOT).endsWith(".disabled")) {
+            final File suspect = result.suspectedFile;
+            final String name = result.suspectedName;
+            builder.setPositiveButton("Switch off " + name, (d, w) -> {
+                File target = new File(suspect.getParentFile(), suspect.getName() + ".disabled");
+                if (!target.exists() && suspect.renameTo(target)) {
+                    Toast.makeText(requireContext(), name + " switched off. You can turn it back on in Mods.",
+                            Toast.LENGTH_LONG).show();
+                } else {
+                    Toast.makeText(requireContext(), "Could not switch off " + name, Toast.LENGTH_LONG).show();
+                }
+            });
+        }
+        builder.show();
+    }
+}
