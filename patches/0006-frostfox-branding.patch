diff --git a/app_mojo/src/main/java/git/artdeell/mojo/frost/SnowView.java b/app_mojo/src/main/java/git/artdeell/mojo/frost/SnowView.java
new file mode 100644
index 0000000000000000000000000000000000000000..03278e9812c0f7eb2a6de571933503b9b869c2c8
--- /dev/null
+++ b/app_mojo/src/main/java/git/artdeell/mojo/frost/SnowView.java
@@ -0,0 +1,161 @@
+package git.artdeell.mojo.frost;
+
+import android.app.ActivityManager;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.os.PowerManager;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.util.AttributeSet;
+import android.view.View;
+
+import git.artdeell.mojo.prefs.LauncherPreferences;
+
+import java.util.Random;
+
+/**
+ * FrostFox: a few dozen small square snowflakes falling slowly behind the home screen.
+ * Drawn in code (no image files), runs at about 20 frames per second, and stops completely when
+ * the view is hidden, the app is in the background, battery saver is on, the system's
+ * "remove animations" setting is on, or the user switched it off.
+ */
+public class SnowView extends View {
+    public static final String PREF_KEY = "frostfoxSnow";
+
+    private static final int FLAKES = 36;
+    private static final long FRAME_MS = 50L;
+
+    private final Paint mPaint = new Paint();
+    private final Random mRandom = new Random();
+    private final float[] mX = new float[FLAKES];
+    private final float[] mY = new float[FLAKES];
+    private final float[] mSpeed = new float[FLAKES];
+    private final float[] mDrift = new float[FLAKES];
+    private final int[] mSize = new int[FLAKES];
+    private final Runnable mFrame = this::invalidate;
+
+    private boolean mAnimating;
+    private long mLastFrame;
+
+    public SnowView(Context context) {
+        this(context, null);
+    }
+
+    public SnowView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setWillNotDraw(false);
+        setClickable(false);
+        setFocusable(false);
+        mPaint.setAntiAlias(false);
+        mPaint.setStyle(Paint.Style.FILL);
+    }
+
+    /** Snow is on by default only on phones with enough memory (about 3 GB or more). */
+    public static boolean defaultEnabled(Context context) {
+        ActivityManager am = (ActivityManager) context.getSystemService(Context.ACTIVITY_SERVICE);
+        if (am == null || am.isLowRamDevice()) return false;
+        ActivityManager.MemoryInfo info = new ActivityManager.MemoryInfo();
+        am.getMemoryInfo(info);
+        return info.totalMem >= 2_500_000_000L;
+    }
+
+    private static boolean allowed(Context context) {
+        if (!LauncherPreferences.DEFAULT_PREF.getBoolean(PREF_KEY, defaultEnabled(context))) return false;
+        PowerManager pm = (PowerManager) context.getSystemService(Context.POWER_SERVICE);
+        if (pm != null && pm.isPowerSaveMode()) return false;
+        float scale = Settings.Global.getFloat(context.getContentResolver(),
+                Settings.Global.ANIMATOR_DURATION_SCALE, 1f);
+        return scale != 0f;
+    }
+
+    private void seed(int width, int height) {
+        float density = getResources().getDisplayMetrics().density;
+        for (int i = 0; i < FLAKES; i++) {
+            mSize[i] = Math.max(2, Math.round((1.5f + mRandom.nextInt(3)) * density));
+            mX[i] = mRandom.nextFloat() * width;
+            mY[i] = mRandom.nextFloat() * height;
+            mSpeed[i] = (14f + mRandom.nextInt(30)) * density;
+            mDrift[i] = (mRandom.nextFloat() - 0.5f) * 14f * density;
+        }
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        if (w > 0 && h > 0) seed(w, h);
+    }
+
+    private void updateAnimation() {
+        boolean should = isShown() && isAttachedToWindow() && getWidth() > 0 && allowed(getContext());
+        if (should && !mAnimating) {
+            mAnimating = true;
+            mLastFrame = SystemClock.uptimeMillis();
+            invalidate();
+        } else if (!should && mAnimating) {
+            mAnimating = false;
+            removeCallbacks(mFrame);
+            invalidate();
+        }
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        updateAnimation();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mAnimating = false;
+        removeCallbacks(mFrame);
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    protected void onVisibilityChanged(View changedView, int visibility) {
+        super.onVisibilityChanged(changedView, visibility);
+        updateAnimation();
+    }
+
+    @Override
+    protected void onWindowVisibilityChanged(int visibility) {
+        super.onWindowVisibilityChanged(visibility);
+        updateAnimation();
+    }
+
+    @Override
+    protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+        super.onLayout(changed, left, top, right, bottom);
+        if (changed) updateAnimation();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        if (!mAnimating) return;
+        int width = getWidth();
+        int height = getHeight();
+        long now = SystemClock.uptimeMillis();
+        float dt = Math.min(0.2f, (now - mLastFrame) / 1000f);
+        mLastFrame = now;
+
+        for (int i = 0; i < FLAKES; i++) {
+            mY[i] += mSpeed[i] * dt;
+            mX[i] += mDrift[i] * dt;
+            if (mY[i] > height) {
+                mY[i] = -mSize[i];
+                mX[i] = mRandom.nextFloat() * width;
+            }
+            if (mX[i] < 0) mX[i] += width;
+            else if (mX[i] > width) mX[i] -= width;
+
+            // Snap to a grid the size of the flake so it looks like pixel art
+            int size = mSize[i];
+            int sx = ((int) (mX[i] / size)) * size;
+            int sy = ((int) (mY[i] / size)) * size;
+            mPaint.setColor(size > 4 ? 0xCCFFFFFF : 0x99DDF2FF);
+            canvas.drawRect(sx, sy, sx + size, sy + size, mPaint);
+        }
+        postDelayed(mFrame, FRAME_MS);
+    }
+}
