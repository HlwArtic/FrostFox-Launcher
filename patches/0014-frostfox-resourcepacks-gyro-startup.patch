+package git.artdeell.mojo.fragments;
+
+import android.content.ContentResolver;
+import android.database.Cursor;
+import android.graphics.Typeface;
+import android.net.Uri;
+import android.os.Bundle;
+import android.provider.OpenableColumns;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.BaseAdapter;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ListView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.widget.SwitchCompat;
+import androidx.fragment.app.Fragment;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import git.artdeell.mojo.MojoApplication;
+import git.artdeell.mojo.Tools;
+import git.artdeell.mojo.instances.Instance;
+import git.artdeell.mojo.instances.Instances;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.io.OutputStreamWriter;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/**
+ * FrostFox: resource packs with an ON/OFF switch each. "On" means the pack is used by the game:
+ * it is listed in the instance's options.txt, exactly as if it had been selected in the game's own
+ * resource pack screen. Nothing is ever deleted. Changes apply the next time the game starts.
+ */
+public class ResourcePacksFragment extends Fragment {
+    public static final String TAG = "ResourcePacksFragment";
+    private static final String OPTION_KEY = "resourcePacks:";
+
+    private static class PackEntry {
+        File file;
+        String name;
+        String detail;
+        boolean enabled;
+    }
+
+    private final List<PackEntry> mPacks = new ArrayList<>();
+    private File mPackDir;
+    private File mOptionsFile;
+    private TextView mSummary;
+    private TextView mEmpty;
+    private PackAdapter mAdapter;
+
+    private final ActivityResultLauncher<String[]> mPicker = registerForActivityResult(
+            new ActivityResultContracts.OpenMultipleDocuments(), this::onFilesPicked);
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container,
+                             @Nullable Bundle savedInstanceState) {
+        int pad = (int) Tools.dpToPx(16);
+        int gap = (int) Tools.dpToPx(8);
+
+        LinearLayout root = new LinearLayout(requireContext());
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(pad, pad, pad, pad);
+
+        TextView title = new TextView(requireContext());
+        title.setText("Resource packs");
+        title.setTextSize(22);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        root.addView(title);
+
+        mSummary = new TextView(requireContext());
+        mSummary.setAlpha(0.7f);
+        root.addView(mSummary);
+
+        TextView hint = new TextView(requireContext());
+        hint.setText("Packs that are on are used the next time you start the game. "
+                + "A pack you turn on goes on top of the others.");
+        hint.setAlpha(0.7f);
+        hint.setPadding(0, 0, 0, gap);
+        root.addView(hint);
+
+        LinearLayout buttons = new LinearLayout(requireContext());
+        buttons.setOrientation(LinearLayout.HORIZONTAL);
+        buttons.addView(makeButton("Add pack", v -> mPicker.launch(new String[]{"*/*"})));
+        buttons.addView(makeButton("All off", v -> allOff()));
+        root.addView(buttons);
+
+        mEmpty = new TextView(requireContext());
+        mEmpty.setText("No resource packs yet. Tap \"Add pack\" and choose a .zip file.");
+        mEmpty.setGravity(Gravity.CENTER);
+        mEmpty.setPadding(pad, pad * 2, pad, pad);
+        mEmpty.setVisibility(View.GONE);
+        root.addView(mEmpty);
+
+        ListView list = new ListView(requireContext());
+        mAdapter = new PackAdapter();
+        list.setAdapter(mAdapter);
+        list.setDividerHeight(0);
+        root.addView(list, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+        return root;
+    }
+
+    private Button makeButton(String text, View.OnClickListener listener) {
+        Button button = new Button(requireContext());
+        button.setText(text);
+        button.setAllCaps(false);
+        button.setOnClickListener(listener);
+        button.setLayoutParams(new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        return button;
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        Instance instance = Instances.loadSelectedInstance();
+        if (instance == null) {
+            Toast.makeText(requireContext(), "No instance selected", Toast.LENGTH_LONG).show();
+            getParentFragmentManager().popBackStack();
+            return;
+        }
+        File gameDir = instance.getGameDirectory();
+        mPackDir = new File(gameDir, "resourcepacks");
+        mOptionsFile = new File(gameDir, "options.txt");
+        reload();
+    }
+
+    // ---------- scanning ----------
+
+    private void reload() {
+        final File packDir = mPackDir;
+        final File optionsFile = mOptionsFile;
+        MojoApplication.sExecutorService.execute(() -> {
+            List<String> enabledNames = readEnabledNames(optionsFile);
+            List<PackEntry> found = new ArrayList<>();
+            File[] files = packDir.listFiles();
+            if (files != null) {
+                for (File file : files) {
+                    boolean zip = file.isFile() && file.getName().toLowerCase(Locale.ROOT).endsWith(".zip");
+                    boolean folder = file.isDirectory() && new File(file, "pack.mcmeta").isFile();
+                    if (!zip && !folder) continue;
+                    PackEntry entry = new PackEntry();
+                    entry.file = file;
+                    entry.name = zip ? file.getName().substring(0, file.getName().length() - 4) : file.getName();
+                    entry.enabled = enabledNames.contains(file.getName());
+                    String description = readDescription(file, zip);
+                    String size = zip ? humanSize(file.length()) : "folder";
+                    entry.detail = description != null && !description.isEmpty() ? description + "  -  " + size : size;
+                    found.add(entry);
+                }
+            }
+            Collections.sort(found, (a, b) -> a.name.compareToIgnoreCase(b.name));
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                mPacks.clear();
+                mPacks.addAll(found);
+                refreshViews();
+            });
+        });
+    }
+
+    private static String humanSize(long bytes) {
+        if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)) + " MB";
+        return Math.max(1, bytes / 1024) + " KB";
+    }
+
+    /** Reads the short description from pack.mcmeta, if there is one. */
+    private static String readDescription(File pack, boolean zip) {
+        try {
+            InputStream in;
+            ZipFile zipFile = null;
+            if (zip) {
+                zipFile = new ZipFile(pack);
+                ZipEntry entry = zipFile.getEntry("pack.mcmeta");
+                if (entry == null) {
+                    zipFile.close();
+                    return null;
+                }
+                in = zipFile.getInputStream(entry);
+            } else {
+                in = new FileInputStream(new File(pack, "pack.mcmeta"));
+            }
+            try (InputStream stream = in; InputStreamReader reader = new InputStreamReader(stream, "UTF-8")) {
+                JsonElement root = new JsonParser().parse(reader);
+                if (!root.isJsonObject()) return null;
+                JsonObject packObject = root.getAsJsonObject().has("pack") && root.getAsJsonObject().get("pack").isJsonObject()
+                        ? root.getAsJsonObject().getAsJsonObject("pack") : null;
+                if (packObject == null || !packObject.has("description") || !packObject.get("description").isJsonPrimitive()) return null;
+                String description = packObject.get("description").getAsString().replaceAll("\u00a7.", "").replace('\n', ' ').trim();
+                return description.length() > 70 ? description.substring(0, 70) + "..." : description;
+            } finally {
+                if (zipFile != null) zipFile.close();
+            }
+        } catch (Exception ignored) {
+            return null;
+        }
+    }
+
+    // ---------- options.txt ----------
+
+    private static List<String> readEnabledNames(File options) {
+        List<String> names = new ArrayList<>();
+        if (!options.isFile()) return names;
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(new FileInputStream(options), "UTF-8"))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (!line.startsWith(OPTION_KEY)) continue;
+                JsonElement value = new JsonParser().parse(line.substring(OPTION_KEY.length()));
+                if (value.isJsonArray()) {
+                    for (JsonElement item : value.getAsJsonArray()) {
+                        if (item.isJsonPrimitive()) names.add(item.getAsString());
+                    }
+                }
+                break;
+            }
+        } catch (Exception ignored) {
+            // An unreadable options file counts as "nothing is on"
+        }
+        return names;
+    }
+
+    private static void writeEnabledNames(File options, List<String> names) throws IOException {
+        List<String> lines = new ArrayList<>();
+        if (options.isFile()) {
+            try (BufferedReader reader = new BufferedReader(new InputStreamReader(new FileInputStream(options), "UTF-8"))) {
+                String line;
+                while ((line = reader.readLine()) != null) lines.add(line);
+            }
+        }
+        JsonArray array = new JsonArray();
+        for (String name : names) array.add(name);
+        String newLine = OPTION_KEY + array.toString();
+        boolean replaced = false;
+        for (int i = 0; i < lines.size(); i++) {
+            if (lines.get(i).startsWith(OPTION_KEY)) {
+                lines.set(i, newLine);
+                replaced = true;
+                break;
+            }
+        }
+        if (!replaced) lines.add(newLine);
+        File parent = options.getParentFile();
+        if (parent != null && !parent.isDirectory() && !parent.mkdirs()) throw new IOException("Cannot create " + parent);
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(options), "UTF-8"))) {
+            for (String line : lines) {
+                writer.write(line);
+                writer.write('\n');
+            }
+        }
+    }
+
+    // ---------- toggling ----------
+
+    private boolean setEnabled(PackEntry entry, boolean enable) {
+        List<String> names = readEnabledNames(mOptionsFile);
+        names.remove(entry.file.getName());
+        if (enable) names.add(entry.file.getName());
+        try {
+            writeEnabledNames(mOptionsFile, names);
+        } catch (IOException e) {
+            Toast.makeText(requireContext(), "Could not change " + entry.name, Toast.LENGTH_LONG).show();
+            return false;
+        }
+        entry.enabled = enable;
+        return true;
+    }
+
+    private void allOff() {
+        List<String> names = readEnabledNames(mOptionsFile);
+        for (PackEntry entry : mPacks) names.remove(entry.file.getName());
+        try {
+            writeEnabledNames(mOptionsFile, names);
+            for (PackEntry entry : mPacks) entry.enabled = false;
+        } catch (IOException e) {
+            Toast.makeText(requireContext(), "Could not change the packs", Toast.LENGTH_LONG).show();
+        }
+        refreshViews();
+    }
+
+    private void refreshViews() {
+        int on = 0;
+        for (PackEntry entry : mPacks) if (entry.enabled) on++;
+        mSummary.setText(mPacks.size() + " packs, " + on + " on");
+        mEmpty.setVisibility(mPacks.isEmpty() ? View.VISIBLE : View.GONE);
+        mAdapter.notifyDataSetChanged();
+    }
+
+    // ---------- adding ----------
+
+    private void onFilesPicked(List<Uri> uris) {
+        if (uris == null || uris.isEmpty()) return;
+        final ContentResolver resolver = requireContext().getContentResolver();
+        final File packDir = mPackDir;
+        MojoApplication.sExecutorService.execute(() -> {
+            int added = 0, skipped = 0;
+            if (!packDir.isDirectory() && !packDir.mkdirs()) skipped = uris.size();
+            else {
+                for (Uri uri : uris) {
+                    String name = displayName(resolver, uri);
+                    if (name == null || !name.toLowerCase(Locale.ROOT).endsWith(".zip")) {
+                        skipped++;
+                        continue;
+                    }
+                    File target = new File(packDir, new File(name).getName());
+                    if (target.exists()) {
+                        skipped++;
+                        continue;
+                    }
+                    try {
+                        copy(resolver, uri, target);
+                        added++;
+                    } catch (IOException e) {
+                        //noinspection ResultOfMethodCallIgnored
+                        target.delete();
+                        skipped++;
+                    }
+                }
+            }
+            final int addedFinal = added, skippedFinal = skipped;
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                String message = addedFinal + " added";
+                if (skippedFinal > 0) message += ", " + skippedFinal + " skipped (not a .zip, or already there)";
+                Toast.makeText(requireContext(), message, Toast.LENGTH_LONG).show();
+                reload();
+            });
+        });
+    }
+
+    private static String displayName(ContentResolver resolver, Uri uri) {
+        try (Cursor cursor = resolver.query(uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) return cursor.getString(0);
+        } catch (Exception ignored) {
+        }
+        return uri.getLastPathSegment();
+    }
+
+    private static void copy(ContentResolver resolver, Uri uri, File target) throws IOException {
+        try (InputStream in = resolver.openInputStream(uri)) {
+            if (in == null) throw new IOException("Cannot open " + uri);
+            try (OutputStream out = new FileOutputStream(target)) {
+                byte[] buffer = new byte[16384];
+                int read;
+                while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            }
+        }
+    }
+
+    // ---------- list rows ----------
+
+    private class PackAdapter extends BaseAdapter {
+        @Override public int getCount() { return mPacks.size(); }
+        @Override public Object getItem(int position) { return mPacks.get(position); }
+        @Override public long getItemId(int position) { return position; }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            LinearLayout row;
+            TextView nameView, detailView;
+            SwitchCompat toggle;
+            if (convertView == null) {
+                int pad = (int) Tools.dpToPx(12);
+                row = new LinearLayout(parent.getContext());
+                row.setOrientation(LinearLayout.HORIZONTAL);
+                row.setGravity(Gravity.CENTER_VERTICAL);
+                row.setPadding(0, pad, 0, pad);
+
+                LinearLayout texts = new LinearLayout(parent.getContext());
+                texts.setOrientation(LinearLayout.VERTICAL);
+                nameView = new TextView(parent.getContext());
+                nameView.setTextSize(16);
+                nameView.setTag("name");
+                detailView = new TextView(parent.getContext());
+                detailView.setTextSize(12);
+                detailView.setAlpha(0.7f);
+                detailView.setTag("detail");
+                texts.addView(nameView);
+                texts.addView(detailView);
+                row.addView(texts, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+
+                toggle = new SwitchCompat(parent.getContext());
+                toggle.setTag("toggle");
+                row.addView(toggle);
+            } else {
+                row = (LinearLayout) convertView;
+                nameView = row.findViewWithTag("name");
+                detailView = row.findViewWithTag("detail");
+                toggle = row.findViewWithTag("toggle");
+            }
+
+            final PackEntry entry = mPacks.get(position);
+            nameView.setText(entry.name);
+            detailView.setText(entry.detail);
+            nameView.setAlpha(entry.enabled ? 1f : 0.5f);
+
+            toggle.setOnCheckedChangeListener(null);
+            toggle.setChecked(entry.enabled);
+            toggle.setOnCheckedChangeListener((button, checked) -> {
+                if (!setEnabled(entry, checked)) {
+                    button.setOnCheckedChangeListener(null);
+                    button.setChecked(entry.enabled);
+                }
+                refreshViews();
+            });
+            return row;
+        }
+    }
+}
